# Production build configuration for the admin portal.
# Provide these as environment variables (or .env.production.local) when running `npm run build`.
VITE_API_URL=https://api.serve.example
# Optional; defaults to VITE_API_URL.
VITE_SOCKET_URL=
# Firebase web app config (Firebase console → Project settings → Your apps). Public values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Optional: where Logout redirects after signing out (e.g. the SERVE landing page).
VITE_ROLE_SELECTION_URL=
# Never set VITE_FIREBASE_AUTH_EMULATOR_HOST for production builds (it is ignored in PROD).
