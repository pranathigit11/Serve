# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/nightcanteen?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development

# Razorpay Configuration (Payments)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"

# Firebase Admin Configuration (For Auth & Notifications)
# These will typically be read from a service account JSON file, but can be provided as env vars.
FIREBASE_PROJECT_ID="your_project_id"
FIREBASE_PRIVATE_KEY="your_private_key"
FIREBASE_CLIENT_EMAIL="your_client_email"
