# ---------------------------------------------------------------------------
# SERVE backend configuration. Copy to .env for local development.
# In production, set these as real environment variables (never commit them).
# The server refuses to start in production with unsafe values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5001
LOG_LEVEL=info
# Number of reverse proxies in front of the API (e.g. 1 behind a load balancer).
TRUST_PROXY_HOPS=0
# Global per-IP requests per minute (campus networks often share one IP).
RATE_LIMIT_PER_MINUTE=1200

# PostgreSQL
DATABASE_URL="postgresql://serve:change-me@localhost:5432/serve_dev?schema=public"

# Browser origins of the staff dashboard, admin portal and student web build.
# Production example: https://staff.serve.example,https://admin.serve.example
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:45678

# Firebase Authentication (identity only; roles live in PostgreSQL).
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional service account JSON (raw or base64). Needed only for admin tooling
# such as `npm run admin:create -- --email ...` against a real project.
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
# DEVELOPMENT ONLY: use the local Auth emulator (firebase emulators:start --only auth).
# Must NOT be set in production (the server refuses to start).
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional student sign-up policy.
STUDENT_EMAIL_DOMAINS=
REQUIRE_EMAIL_VERIFIED=false

# Payments. Only the simulated "mock" provider exists today.
PAYMENT_MODE=mock
# HMAC secret used to sign mock gateway results (>= 32 random chars in production).
MOCK_PAYMENT_SECRET=dev-only-mock-payment-secret-change-me
# Production refuses PAYMENT_MODE=mock unless this is explicitly true.
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false
# Unpaid orders are cancelled after this many minutes.
PENDING_PAYMENT_TTL_MINUTES=30
