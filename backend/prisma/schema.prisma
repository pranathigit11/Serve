generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Canteen {
  id                String   @id @default(uuid())
  name              String
  location          String
  isActive          Boolean  @default(true)
  isAcceptingOrders Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  hostels               Hostel[]
  staff                 Staff[]
  menuItems             MenuItem[]
  
  changeRequestsCurrent   CanteenChangeRequest[] @relation("CurrentCanteen")
  changeRequestsRequested CanteenChangeRequest[] @relation("RequestedCanteen")

  orders                Order[]
}

model Hostel {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  canteenId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  canteen   Canteen   @relation(fields: [canteenId], references: [id])
  students  Student[]
  orders    Order[]

  @@index([canteenId])
}

model Student {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  studentId String   @unique
  hostelId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostel    Hostel   @relation(fields: [hostelId], references: [id])
  orders    Order[]

  @@index([hostelId])
}

model Staff {
  id                String   @id @default(uuid())
  name              String
  staffId           String   @unique
  email             String   @unique
  assignedCanteenId String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignedCanteen   Canteen  @relation(fields: [assignedCanteenId], references: [id])
  changeRequests    CanteenChangeRequest[]

  @@index([assignedCanteenId])
}

model Admin {
  id        String   @id @default(uuid())
  name      String
  adminId   String   @unique
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedChangeRequests CanteenChangeRequest[]
}

model MenuCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems MenuItem[]
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  canteenId   String
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  canteen     Canteen      @relation(fields: [canteenId], references: [id])
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([canteenId])
  @@index([categoryId])
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CanteenChangeRequest {
  id                 String              @id @default(uuid())
  staffId            String
  currentCanteenId   String
  requestedCanteenId String
  reason             String?
  status             ChangeRequestStatus @default(PENDING)
  requestedAt        DateTime            @default(now())
  reviewedAt         DateTime?
  reviewedByAdminId  String?
  reviewNote         String?

  staff              Staff   @relation(fields: [staffId], references: [id])
  currentCanteen     Canteen @relation("CurrentCanteen", fields: [currentCanteenId], references: [id])
  requestedCanteen   Canteen @relation("RequestedCanteen", fields: [requestedCanteenId], references: [id])
  reviewedByAdmin    Admin?  @relation(fields: [reviewedByAdminId], references: [id])

  @@index([staffId])
  @@index([currentCanteenId])
  @@index([requestedCanteenId])
  @@index([status])
}

enum OrderStatus {
  PLACED
  PAYMENT_CONFIRMED
  PREPARING
  READY
  COLLECTED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  studentId   String
  hostelId    String
  canteenId   String
  status      OrderStatus @default(PLACED)
  totalAmount Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  student     Student     @relation(fields: [studentId], references: [id])
  hostel      Hostel      @relation(fields: [hostelId], references: [id])
  canteen     Canteen     @relation(fields: [canteenId], references: [id])
  items       OrderItem[]

  @@index([orderNumber])
  @@index([studentId])
  @@index([hostelId])
  @@index([canteenId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  itemName   String
  createdAt  DateTime @default(now())

  order      Order    @relation(fields: [orderId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
}
